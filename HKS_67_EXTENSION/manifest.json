{
  "manifest_version": 3,
  "name": "HKS_67 \u00b7 Instagram Comments",
  "version": "5.0.0",
  "minimum_chrome_version": "111",
  "description": "Collect comments and replies, inspect returned media, and export local tables, Excel charts and analysis. Optional reviewed AI handoff.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HKS_67",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["core.js", "browser.js", "collector.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "https://*.giphy.com/*"
  ]
}
